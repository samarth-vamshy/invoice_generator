{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
    "manifestVersion": "1.30",
    "version": "1.0.1",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Invoice_generator_Azure${{APP_NAME_SUFFIX}}",
        "full": "full name for Invoice_generator_Azure"
    },
    "description": {
        "short": "short description for Invoice_generator_Azure",
        "full": "full description for Invoice_generator_Azure"
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "team",
                "groupChat",
                "personal",
                "copilot"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "supportsTargetedMessages": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal",
                        "copilot"
                    ],
                    "triggers": ["mention"],
                    "commands": [
                        {
                            "title": "Generate Invoices",
                            "description": "Create an invoice PDF in the Invoice Library."
                        },
                        {
                            "title": "Help",
                            "description": "See what the Invoice Generator can do."
                        }
                    ]
                }
            ]
        }
    ],
    "copilotAgents": {
        "customEngineAgents": [
            {
                "type": "bot",
                "id": "${{BOT_ID}}"
            }
        ]
    },
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}
